# Yandex Maps API Key
# Get your key at https://developer.tech.yandex.ru/
VITE_YANDEX_MAPS_API_KEY=your_api_key_here

# Backend API URL (optional, defaults to http://localhost:3001/api)
# VITE_API_URL=http://localhost:3001/api

# Note: VITE_GEMINI_API_KEY is no longer needed here
# The Gemini API key is now securely stored on the backend

# Local-only auth bypass for development.
# On localhost it is available automatically in Vite dev mode.
# VITE_ENABLE_DEV_LOGIN=true
# VITE_DEV_LOGIN_EMAIL=local-smoke@nlmk.com
